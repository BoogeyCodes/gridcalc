{
  "name": "gridcalc",
  "version": "0.1.0",
  "description": "A zero-dependency spreadsheet formula engine for TypeScript: a formula parser, cell references and ranges, a dependency graph with incremental recompute, and circular-reference detection.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "spreadsheet",
    "formula",
    "formula-parser",
    "formula-engine",
    "excel",
    "parser",
    "pratt-parser",
    "typescript",
    "zero-dependency"
  ],
  "author": "Abdul Raheem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BoogeyCodes/gridcalc.git"
  },
  "homepage": "https://github.com/BoogeyCodes/gridcalc#readme",
  "bugs": {
    "url": "https://github.com/BoogeyCodes/gridcalc/issues"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
